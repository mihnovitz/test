<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvFirstActivity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/first_activity_label"
        android:textSize="18sp"
        android:layout_marginBottom="24dp" />

    <ImageView
        android:id="@+id/ivAndroidLogo"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:contentDescription="@string/android_logo_desc"
        android:src="@drawable/ic_android"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnStartActivity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_start_activity"
        android:textAllCaps="true" />

</LinearLayout>
